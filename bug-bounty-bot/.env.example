# ============================================================
# Bug Bounty Bot - Variáveis de Ambiente (exemplo)
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA faça commit do arquivo `.env` com credenciais reais.
# ============================================================

# Token de acesso pessoal do GitHub (Personal Access Token).
# Usado para autenticar chamadas à API de busca de código.
GITHUB_TOKEN=your_github_personal_access_token_here

# Token do bot do Telegram (obtido via @BotFather).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID do chat/canal do Telegram que receberá os alertas.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Intervalo de polling em milissegundos entre ciclos de varredura.
POLLING_INTERVAL_MS=60000
