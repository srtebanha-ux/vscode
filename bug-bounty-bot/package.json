{
  "name": "bug-bounty-bot",
  "version": "0.1.0",
  "description": "Bot de Bug Bounty focado em detectar vazamento de credenciais (Secret Leaks) via API do GitHub, com notificações via Telegram.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "serve": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bug-bounty",
    "security",
    "secret-scanning",
    "github",
    "telegram"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-telegram-bot-api": "^0.64.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
