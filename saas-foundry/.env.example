# ── SaaS Foundry — variáveis de ambiente ─────────────────────────────
# Copie os valores no painel da Vercel (Settings -> Environment Variables).
# Prefixo VITE_ = exposto ao browser. NUNCA coloque segredos em VITE_*.

# Firebase (browser — console.firebase.google.com -> Configurações do projeto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe (browser — apenas a chave PUBLICÁVEL, pk_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe (SOMENTE servidor: Cloud Function / Serverless — sem prefixo VITE_,
# o browser jamais enxerga estes valores)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
