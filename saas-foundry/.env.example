# ── SaaS Foundry — variáveis de ambiente ─────────────────────────────
# Copie os valores no painel da Vercel (Settings -> Environment Variables).
# Prefixo VITE_ = exposto ao browser. NUNCA coloque segredos em VITE_*.

# Firebase (browser — console.firebase.google.com -> Configurações do projeto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe (browser — apenas a chave PUBLICÁVEL, pk_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# PostHog (browser — Project API Key phc_..., é pública por design)
# Sem estes valores a telemetria degrada para console.debug no dev.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (SOMENTE servidor: Cloud Function / Serverless — sem prefixo VITE_,
# o browser jamais enxerga estes valores)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic (SOMENTE servidor — /api/cognitive-engine chama a LLM com esta
# chave; sem ela o motor responde em modo simulado no dev/preview)
ANTHROPIC_API_KEY=

# E-mail transacional (SOMENTE servidor — WelcomeEmailService). Com RESEND_API_KEY
# envia via Resend; senão cai no SMTP; sem nenhum, degrada para "skipped" no dev.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Segredo do Magic Link (JWT sem senha) + URL base do app para montar o link
JWT_MAGIC_SECRET=
APP_URL=https://app.lidarcore.example

# Banco de dados (Prisma / PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/lidarcore
