# Firebase (console.firebase.google.com -> Configurações do projeto -> Seus apps)
# Copie para .env.local. Sem estes valores o shell sobe em modo dev (MockApiService).
# O MockApiService cobre APENAS a camada de dados (tarefas/Firestore);
# o Oráculo de Preços sempre faz fetch HTTP real em /api/oracle-pricing.

# Oráculo de Preços (Google Gemini) — sem prefixo VITE_: a chave fica só no
# servidor (dev server do Vite no localhost; Environment Variables na Vercel).
GEMINI_API_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
