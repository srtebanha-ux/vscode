{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.internal/schemas/saas-module-manifest.json",
  "title": "SaaSModuleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "version", "scopes", "dependencies", "outboundAllowlist", "limits", "templateVars"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,40}$",
      "description": "Machine name; becomes part of the namespace. No dots, slashes or uppercase."
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scopes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {
        "enum": [
          "storage:read",
          "storage:write",
          "net:outbound",
          "auth:read-profile",
          "billing:read",
          "events:emit",
          "events:subscribe",
          "ui:render",
          "read:tasks",
          "write:tasks",
          "read:production",
          "write:production",
          "read:logistics",
          "write:logistics"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockId", "version", "integrity"],
        "properties": {
          "blockId": { "type": "string", "pattern": "^block\\.[a-z][a-z0-9-]{1,40}$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/=]{44}$" }
        }
      }
    },
    "outboundAllowlist": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
        "description": "Bare hostnames only. No wildcards, schemes, ports, paths or IPs."
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMemoryMb", "maxCpuMs", "maxStorageMb", "maxOutboundReqPerMin"],
      "properties": {
        "maxMemoryMb": { "type": "integer", "minimum": 16, "maximum": 512 },
        "maxCpuMs": { "type": "integer", "minimum": 10, "maximum": 5000 },
        "maxStorageMb": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "maxOutboundReqPerMin": { "type": "integer", "minimum": 0, "maximum": 600 }
      }
    },
    "templateVars": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,40}$" },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  }
}
